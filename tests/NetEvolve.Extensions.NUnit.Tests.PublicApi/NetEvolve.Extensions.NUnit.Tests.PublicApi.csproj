<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(NetEvolve_TestTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!-- Do not copy referenced .pdb files to the output directory. PublicApiGenerator reads the
         assembly under test via Mono.Cecil, which throws SymbolsNotMatchingException if it finds
         a .pdb next to the assembly that code coverage instrumentation has rewritten out of sync
         with it. The public API surface does not require debug symbols. -->
    <AllowedReferenceRelatedFileExtensions>.xml</AllowedReferenceRelatedFileExtensions>
    <!-- Verify v33+ build-time license gate (SC021). Extensions.Test is a non-revenue open source project, so the OpenSource exemption applies.
         See https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
         Renew yearly: the end month may be at most 12 months ahead of the build date; builds fail after 2027-09. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="PublicApiGenerator" />
    <PackageReference Include="Verify.Nunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetEvolve.Extensions.NUnit\NetEvolve.Extensions.NUnit.csproj" />
  </ItemGroup>
</Project>
