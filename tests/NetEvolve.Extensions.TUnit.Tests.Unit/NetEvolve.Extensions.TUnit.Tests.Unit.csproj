<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Verify v33+ build-time license gate (SC021). Extensions.Test is a non-revenue open source project, so the OpenSource exemption applies.
         See https://github.com/VerifyTests/Verify/blob/main/docs/maintenance-fee.md
         Renew yearly: the end month may be at most 12 months ahead of the build date; builds fail after 2027-09. -->
    <Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
    <Verify_SponsorshipExemptionUntil>2027-09</Verify_SponsorshipExemptionUntil>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />
    <PackageReference Include="Verify.TUnit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NetEvolve.Extensions.TUnit\NetEvolve.Extensions.TUnit.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="NetEvolve.Extensions.TUnit.TestGroupAttribute">
      <_Parameter1>TUnit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
